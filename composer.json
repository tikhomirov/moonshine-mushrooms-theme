{
    "name": "tikhomirov/moonshine-mushrooms-theme",
    "description": "Mushrooms theme for MoonShine admin panel",
    "type": "library",
    "version": "1.6.3",
    "license": "MIT",
    "keywords": [
        "moonshine",
        "laravel",
        "admin",
        "theme"
    ],
    "require": {
        "php": "^8.3",
        "moonshine/moonshine": "^4.8"
    },
    "autoload": {
        "psr-4": {
            "Tikhomirov\\MoonShineMushroomsTheme\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tikhomirov\\MoonShineMushroomsTheme\\MushroomsThemeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "orchestra/testbench": "^10.0"
    },
    "scripts": {
        "lint": "./vendor/bin/pint",
        "lint:test": "./vendor/bin/pint --test",
        "test:types": "./vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
        "ci": [
            "@lint:test",
            "@test:types"
        ],
        "ci:fix": [
            "@lint"
        ]
    }
}
